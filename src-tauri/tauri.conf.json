{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MindGrid",
  "version": "0.3.1",
  "identifier": "com.mindgrid.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MindGrid",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MindGrid",
    "copyright": "Copyright © 2026 MindGrid. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "MindGrid — 思维导图与可视化思考工具",
    "longDescription": "MindGrid 是一款桌面思维导图应用，支持 6 种图表类型（思维导图、逻辑图、树形图、组织架构图、鱼骨图、时间线），具备富内容编辑、关系线/边界/概要、模板系统、演示模式、Markdown/OPML 导入导出、PNG/SVG 图像导出，以及 10k 节点级别的高性能画布运行时。",
    "homepage": "https://github.com/jincaiw/mindgrid",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "MindGrid Document",
        "description": "MindGrid 思维导图文档",
        "ext": ["mgd"],
        "mimeType": "application/vnd.mindgrid.document",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "bundleName": "MindGrid",
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "recommends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jincaiw/mindgrid/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY",
      "dialog": false
    }
  }
}
